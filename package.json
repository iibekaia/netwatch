{
  "name": "netwatch",
  "version": "1.1.7",
  "scripts": {
    "ng": "ng",
    "start": "ng build && electron .",
    "dev": "concurrently -k -n ng,electron -c magenta,cyan \"ng serve --port 4200\" \"wait-on tcp:127.0.0.1:4200 && electron . --dev\"",
    "electron": "electron .",
    "build": "ng build",
    "test": "node scripts/test.js",
    "dist": "ng build && electron-builder --publish never",
    "dist:win": "ng build && electron-builder --win --publish never",
    "dist:mac": "ng build && electron-builder --mac --publish never",
    "dist:linux": "ng build && electron-builder --linux --publish never",
    "oui": "electron scripts/build-oui.js",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-georgian": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.7.0",
    "concurrently": "^10.0.5",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.4.0",
    "oui-data": "^2.1.34",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "wait-on": "^9.5.1"
  },
  "description": "Electron + Angular — ინტერნეტ-კავშირის ლაივ მონიტორი",
  "main": "electron/main.js",
  "author": "iibekaia",
  "build": {
    "appId": "com.iibekaia.netwatch",
    "productName": "NetWatch",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/netwatch/browser/**/*",
      "package.json",
      "build/icon.ico",
      "build/icon.png",
      "build/tray/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetWatch",
      "artifactName": "NetWatch-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "NetWatch-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iibekaia",
        "repo": "netwatch"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "artifactName": "NetWatch-mac.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "NetWatch სკანირებს ლოკალურ ქსელს, რომ აჩვენოს მოწყობილობები და NetWatch-ის სხვა მომხმარებლები."
      }
    },
    "dmg": {
      "title": "NetWatch"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "ინტერნეტ-კავშირის ლაივ მონიტორი",
      "artifactName": "NetWatch-linux.${ext}"
    },
    "asarUnpack": [
      "electron/data/**"
    ]
  },
  "lint-staged": {
    "*.{ts,html,js}": "eslint --cache --cache-location node_modules/.cache/eslint --max-warnings 0"
  }
}
